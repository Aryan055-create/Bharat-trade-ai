<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="BHARAT TRADE AI" android:textSize="26sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="PAPER MODE" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/symbol" android:text="NIFTY" android:singleLine="true" android:hint="Symbol" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/refresh" android:text="GET AI SIGNAL" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/signal" android:text="SIGNAL: NO TRADE" android:textSize="22sp" android:textStyle="bold" android:paddingTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/details" android:text="Connect the app to the v4 backend." android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/kill" android:text="KILL SWITCH" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
